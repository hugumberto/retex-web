{
  "projects": {
    "landing-page": {
      "root": "apps/landing-page",
      "sourceRoot": "apps/landing-page/src",
      "projectType": "application",
      "targets": {
        "build": {
          "executor": "@nx/next:build",
          "options": {
            "outputPath": "dist/apps/landing-page"
          }
        },
        "serve": {
          "executor": "@nx/next:server",
          "options": {
            "buildTarget": "landing-page:build",
            "dev": true
          }
        }
      }
    }
  }
}
